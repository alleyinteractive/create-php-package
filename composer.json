{
    "name": "alleyinteractive/create-php-package",
    "description": "A skeleton PHP package geared for WordPress Development",
    "type": "library",
    "keywords": [
        "alleyinteractive",
        "create-php-package"
    ],
    "homepage": "https://github.com/alleyinteractive/create-php-package",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "author_name",
            "email": "email@domain.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.6",
        "mantle-framework/testkit": "^1.15",
        "rector/rector": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Alley\\CreatePhpPackage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alley\\CreatePhpPackage\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpcbf": "phpcbf .",
        "phpcs": "phpcs .",
        "phpstan": "phpstan --memory-limit=512M",
        "lint": [
            "@phpcs",
            "@phpstan",
            "@rector"
        ],
        "lint:fix": [
            "@rector:fix",
            "@phpcbf"
        ],
        "phpunit": "phpunit",
        "rector:fix": "rector process",
        "rector": "rector process --dry-run",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}
